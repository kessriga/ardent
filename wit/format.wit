package ardent:format@0.1.0;

interface scanner {
    record prefix {
        name: string,
        files: list<string>,
    }

    record metadata {
        name: string,
        version: string,
        files: list<string>,
        prefixes: list<prefix>,
    }

    record byte-range {
        start: u32,
        end: u32,
    }

    record node {
        parent: option<u32>,
        kind: string,
        label: string,
        span: byte-range,
        label-ranges: list<byte-range>,
    }

    record position {
        line: u32,
        column: u32,
    }

    variant scan-error {
        syntax(position),
        failure(string),
    }

    describe: func() -> metadata;
    scan: func(source: list<u8>) -> result<list<node>, scan-error>;
}

world format-plugin {
    export scanner;
}

interface query-preparation {
    prepare: func();
}

interface highlighter {
    enum category { keyword, string-literal, comment, heading, code }

    record span {
        start: u32,
        end: u32,
        category: category,
    }

    highlight: func(source: list<u8>) -> list<span>;
}

world syntax-highlighting {
    export highlighter;
}

world query-setup {
    export query-preparation;
}

interface node-properties {
    record property {
        name: string,
        value: string,
        inline: bool,
    }

    record group {
        node: u32,
        properties: list<property>,
    }

    properties: func(source: list<u8>) -> list<group>;
}

world source-properties {
    export node-properties;
}
